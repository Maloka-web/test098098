<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>ملك ♥</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --plum-950:#20101a;
    --plum-900:#2b1420;
    --wine-700:#5c1f34;
    --rose-400:#e8a0b4;
    --rose-200:#f6dbe2;
    --gold-400:#d4af7a;
    --cream-50:#f7ece7;
    --shadow: 0 20px 60px rgba(0,0,0,.45);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html,body{height:100%;}
  body{
    min-height:100vh;
    background:
      radial-gradient(1200px 800px at 20% -10%, var(--wine-700) 0%, transparent 55%),
      radial-gradient(1000px 700px at 100% 110%, #3a1224 0%, transparent 55%),
      var(--plum-950);
    color:var(--cream-50);
    font-family:'Tajawal', sans-serif;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow-x:hidden;
    position:relative;
  }

  /* ambient floating petals */
  .petal{
    position:fixed; top:-40px; font-size:18px; opacity:.55;
    animation:fall linear infinite; pointer-events:none; z-index:0;
    filter:drop-shadow(0 0 6px rgba(232,160,180,.4));
  }
  @keyframes fall{
    to{ transform:translateY(110vh) rotate(360deg); opacity:0; }
  }

  .stage{
    position:relative; z-index:1;
    width:100%; max-width:460px; min-height:100vh;
    display:flex; align-items:center; justify-content:center;
    padding:28px;
  }

  .screen{
    display:none;
    width:100%;
    background:linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.02));
    border:1px solid rgba(212,175,122,.25);
    border-radius:22px;
    padding:38px 26px;
    text-align:center;
    box-shadow:var(--shadow);
    backdrop-filter: blur(6px);
    animation:enter .6s ease both;
  }
  .screen.active{display:block;}
  @keyframes enter{
    from{opacity:0; transform:translateY(16px) scale(.98);}
    to{opacity:1; transform:translateY(0) scale(1);}
  }

  .eyebrow{
    font-size:12px; letter-spacing:.35em; color:var(--gold-400);
    text-transform:uppercase; margin-bottom:14px; font-weight:500;
  }
  h1,h2{
    font-family:'Aref Ruqaa', serif;
    color:var(--rose-200);
    line-height:1.5;
  }
  h1{font-size:30px; margin-bottom:8px;}
  h2{font-size:24px; margin-bottom:16px;}

  .sub{color:var(--rose-400); font-size:14px; margin-bottom:26px; opacity:.9;}

  input[type="password"]{
    width:100%;
    background:rgba(0,0,0,.25);
    border:1px solid rgba(212,175,122,.4);
    border-radius:14px;
    padding:16px 18px;
    color:var(--cream-50);
    font-size:20px;
    letter-spacing:.4em;
    text-align:center;
    outline:none;
    transition:.25s;
  }
  input[type="password"]:focus{
    border-color:var(--gold-400);
    box-shadow:0 0 0 4px rgba(212,175,122,.15);
  }
  input.shake{animation:shake .4s;}
  @keyframes shake{
    0%,100%{transform:translateX(0);}
    25%{transform:translateX(-8px);}
    75%{transform:translateX(8px);}
  }
  .error{color:#e88; font-size:13px; height:18px; margin-top:10px;}

  .btn{
    margin-top:22px;
    display:inline-block;
    background:linear-gradient(135deg, var(--rose-400), var(--wine-700));
    color:#fff;
    border:none;
    padding:14px 34px;
    font-family:'Tajawal', sans-serif;
    font-size:16px;
    font-weight:700;
    border-radius:999px;
    cursor:pointer;
    box-shadow:0 10px 24px rgba(92,31,52,.5);
    transition:transform .2s, box-shadow .2s;
  }
  .btn:hover{transform:translateY(-2px); box-shadow:0 14px 30px rgba(92,31,52,.6);}
  .btn:active{transform:translateY(0);}
  .btn:focus-visible{outline:3px solid var(--gold-400); outline-offset:3px;}

  /* rose */
  .rose-wrap{
    width:150px; height:150px; margin:10px auto 6px;
    display:flex; align-items:center; justify-content:center;
    cursor:pointer; user-select:none;
    border:none; background:none;
  }
  .rose-wrap:focus-visible{outline:3px solid var(--gold-400); outline-offset:6px; border-radius:50%;}
  .rose{
    font-size:80px;
    animation:pulse 1.8s ease-in-out infinite;
    filter: drop-shadow(0 0 18px rgba(232,160,180,.55));
  }
  @keyframes pulse{
    0%,100%{transform:scale(1);}
    50%{transform:scale(1.08);}
  }
  .rose.bloom{ animation: bloom .7s ease forwards; }
  @keyframes bloom{
    0%{transform:scale(1);}
    40%{transform:scale(1.5) rotate(8deg);}
    100%{transform:scale(0); opacity:0;}
  }

  .letter{
    font-family:'Aref Ruqaa', serif;
    font-size:19px;
    line-height:2.1;
    color:var(--cream-50);
    text-align:center;
    white-space:pre-line;
  }

  .photos{
    display:flex; gap:14px; justify-content:center; margin:10px 0 20px; flex-wrap:wrap;
  }
  .photo-slot{
    width:140px; height:180px;
    border-radius:16px;
    overflow:hidden;
    border:2px dashed rgba(212,175,122,.5);
    display:flex; align-items:center; justify-content:center;
    background:rgba(0,0,0,.2);
    color:var(--gold-400);
    font-size:13px;
    text-align:center;
    padding:8px;
  }
  .photo-slot img{width:100%; height:100%; object-fit:cover; display:block;}

  .date-badge{
    font-family:'Aref Ruqaa', serif;
    font-size:34px;
    color:var(--gold-400);
    letter-spacing:.05em;
    margin:14px 0 4px;
  }
  .date-caption{color:var(--rose-400); font-size:14px; margin-bottom:6px;}

  .counter{
    display:flex; gap:10px; justify-content:center; margin:22px 0 10px; flex-wrap:wrap;
  }
  .counter-box{
    background:rgba(0,0,0,.25);
    border:1px solid rgba(212,175,122,.35);
    border-radius:14px;
    padding:12px 10px;
    min-width:62px;
  }
  .counter-box span{
    display:block;
    font-family:'Aref Ruqaa', serif;
    font-size:26px;
    color:var(--gold-400);
    line-height:1;
  }
  .counter-box small{
    display:block;
    margin-top:6px;
    font-size:11px;
    color:var(--rose-200);
    opacity:.8;
  }
  .counter-label{color:var(--rose-400); font-size:13px; margin-top:4px;}

  .hearts-row{font-size:22px; margin-top:18px; letter-spacing:6px;}

  footer.small{
    margin-top:18px; font-size:11px; color:rgba(247,236,231,.4);
  }
</style>
</head>
<body>

<div class="stage">

  <!-- 1. Lock screen -->
  <section class="screen active" id="screen-lock">
    <div class="eyebrow">خاص بيها</div>
    <h1>ملك ♥</h1>
    <p class="sub">أدخلي كلمة السر عشان تفتحي المفاجأة</p>
    <input type="tel" id="pwInput" inputmode="numeric" maxlength="10" placeholder="••••••" autocomplete="off">
    <div class="error" id="pwError"></div>
    <button class="btn" id="unlockBtn">افتحي 🔓</button>
  </section>

  <!-- 2. Rose screen -->
  <section class="screen" id="screen-rose">
    <div class="eyebrow">لسه فيه حاجة</div>
    <h2>دوسي على الوردة</h2>
    <button class="rose-wrap" id="roseBtn" aria-label="دوسي على الوردة">
      <span class="rose" id="roseEmoji">🌹</span>
    </button>
    <p class="sub" style="margin-top:18px;">❤️</p>
  </section>

  <!-- 3. Letter screen -->
  <section class="screen" id="screen-letter">
    <div class="eyebrow">من قلبي</div>
    <p class="letter">من أول يوم عرفتك وأنا حاسس إن حياتي بقت أحلى. ضحكتك بتخليني أنسى أي هم، وكلامك بيديني طاقة وحب. إنتي مش بس جزء من حياتي، إنتي حياتي كلها. بحبك من قلبي، وهفضل أحبك طول العمر 💕

بحبك يا عيوني ♥️🫂</p>
    <button class="btn next-btn" data-next="screen-photos">Next 💕</button>
  </section>

  <!-- 4. Photos screen -->
  <section class="screen" id="screen-photos">
    <div class="eyebrow">أجمل حاجة بشوفها</div>
    <h2>اجمل بنوته بتشوفها عيني</h2>
    <div class="photos">
      <div class="photo-slot" id="slot1"><img src="data:image/jpeg;base64," alt="ملك"></div>
      <div class="photo-slot" id="slot2"><img src="data:image/jpeg;base64," alt="ملك"></div>
    </div>
    <button class="btn next-btn" data-next="screen-date">Next 💕</button>
  </section>

  <!-- 5. Date screen -->
  <section class="screen" id="screen-date">
    <div class="eyebrow">يوم ما اتغيرت حياتي</div>
    <h2>تاريخ تعارفنا</h2>
    <div class="date-badge">23 / 9 / 2024</div>
    <div class="date-caption">أحلى يوم في حياتي 🤍</div>
    <div class="counter" id="dayCounter">
      <div class="counter-box"><span id="cDays">0</span><small>يوم</small></div>
      <div class="counter-box"><span id="cHours">0</span><small>ساعة</small></div>
      <div class="counter-box"><span id="cMins">0</span><small>دقيقة</small></div>
      <div class="counter-box"><span id="cSecs">0</span><small>ثانية</small></div>
    </div>
    <div class="counter-label">ومن يومها وإحنا سوا 💞</div>
    <button class="btn next-btn" data-next="screen-final">Next 💕</button>
  </section>

  <!-- 6. Final screen -->
  <section class="screen" id="screen-final">
    <div class="eyebrow">حابب اقولك</div>
    <p class="letter">حابب اقولك...
مهما الدنيا ودتنا فين، أو بعدنا عن بعض قد اي، هتفضلي إنتي أغلى حد في حياتي كلها، وبيتي اللي أنا بارتاح فيه، ومليش غيرك.</p>
    <div class="hearts-row">♥️ 🫂 💕</div>
    <footer class="small">صنعت بحب ليكي، يا ملك.</footer>
  </section>

</div>

<!-- Background music: replace src below with your song file/link -->
<audio id="bgm" loop preload="auto">
  <source src="data:audio/mpeg;base64," type="audio/mpeg">
</audio>

<script>
  const CORRECT_PASSWORD = "422007";

  // floating petals
  const petals = ["🌸","🌹","💮","❀"];
  for(let i=0;i<14;i++){
    const p = document.createElement("div");
    p.className = "petal";
    p.textContent = petals[Math.floor(Math.random()*petals.length)];
    p.style.left = Math.random()*100 + "vw";
    p.style.animationDuration = (8 + Math.random()*10) + "s";
    p.style.animationDelay = (Math.random()*10) + "s";
    p.style.fontSize = (14 + Math.random()*14) + "px";
    document.body.appendChild(p);
  }

  function showScreen(id){
    document.querySelectorAll(".screen").forEach(s => s.classList.remove("active"));
    document.getElementById(id).classList.add("active");
  }

  // 1. Unlock
  const pwInput = document.getElementById("pwInput");
  const pwError = document.getElementById("pwError");
  const bgm = document.getElementById("bgm");

  function tryUnlock(){
    if(pwInput.value.trim() === CORRECT_PASSWORD){
      pwError.textContent = "";
      showScreen("screen-rose");
      bgm.play().catch(()=>{ /* autoplay may need another tap; that's fine */ });
    } else {
      pwError.textContent = "كلمة السر مش صح، جربي تاني";
      pwInput.classList.remove("shake");
      void pwInput.offsetWidth;
      pwInput.classList.add("shake");
    }
  }
  document.getElementById("unlockBtn").addEventListener("click", tryUnlock);
  pwInput.addEventListener("keydown", e => { if(e.key === "Enter") tryUnlock(); });

  // 2. Rose click -> bloom -> letter
  document.getElementById("roseBtn").addEventListener("click", () => {
    const rose = document.getElementById("roseEmoji");
    rose.classList.add("bloom");
    setTimeout(() => showScreen("screen-letter"), 550);
  });

  // Next buttons
  document.querySelectorAll(".next-btn").forEach(btn=>{
    btn.addEventListener("click", () => showScreen(btn.dataset.next));
  });

  // Live "days together" counter since 23/9/2024
  const startDate = new Date(2024, 8, 23, 0, 0, 0); // month is 0-indexed: 8 = September
  const elDays = document.getElementById("cDays");
  const elHours = document.getElementById("cHours");
  const elMins = document.getElementById("cMins");
  const elSecs = document.getElementById("cSecs");

  function updateCounter(){
    const now = new Date();
    let diff = Math.floor((now - startDate) / 1000); // seconds
    if(diff < 0) diff = 0;
    const days = Math.floor(diff / 86400);
    const hours = Math.floor((diff % 86400) / 3600);
    const mins = Math.floor((diff % 3600) / 60);
    const secs = diff % 60;
    elDays.textContent = days;
    elHours.textContent = String(hours).padStart(2,"0");
    elMins.textContent = String(mins).padStart(2,"0");
    elSecs.textContent = String(secs).padStart(2,"0");
  }
  updateCounter();
  setInterval(updateCounter, 1000);
</script>

</body>
</html>
